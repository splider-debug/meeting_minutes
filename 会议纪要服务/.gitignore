# ============================================================
# 会议纪要服务 · .gitignore（安全网）
# 仓库根现在在上一级：会议资料整理/.gitignore 才是主规则。
# 这份保留是为了"万一有人只把本目录当仓库"时也不泄露密钥、不误提交 venv/data。
# ============================================================

# ---------- 密钥：绝对不要提交 ----------
# 里面是 DEEPSEEK_API_KEY / SESSION_SECRET / AUTH_PASSWORDS。
# 一旦进了 git 历史，即使之后删除也仍能从历史里翻出来，只能作废重发。
.env
.env.local
*.env
!.env.example

# ---------- 虚拟环境（950 MB）----------
venv/
.venv/
env/
ENV/

# ---------- 运行数据（237 MB，含模型缓存）----------
data/
runs/
_cache/
_imgtest/
_test/
*.sqlite
*.db

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 临时文件与中间产物 ----------
*.tmp
*.temp
tmp/
temp_download/
tmp_download/
*.log
result.zip

# ---------- Office / WPS ----------
~$*.docx
~$*.xlsx
~$*.pptx
.~lock.*
*.docx#*

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ---------- Univer 临时文件 ----------
*.univer
_chk.univer
_verify.univer
