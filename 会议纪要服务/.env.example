# ---- 模型（你的 token）----
DEEPSEEK_API_KEY=sk-换成你的
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_MAIN=deepseek-chat
MODEL_STRONG=deepseek-reasoner

# ---- 认证：共享口令，多个用逗号分隔（好输入、够用）----
AUTH_PASSWORDS=huiyi2026
# 生成方式：openssl rand -hex 32
SESSION_SECRET=换成随机串
SESSION_MAX_AGE=2592000

# ---- 限额 ----
MAX_UPLOAD_MB=50
TASK_TIMEOUT_SEC=1200
ARTIFACT_TTL_SEC=3600

# ---- 路径（容器内固定，一般不用改）----
DATA_DIR=/data
TOOLS_DIR=/app/app/tools

# OCR 引擎已统一为 RapidOCR：模型打包在 wheel 里，不需要下载、不需要缓存目录。
# 只有回退到 paddle 引擎时才需要 PADDLE_PDX_CACHE_HOME，且必须指向可写路径
# （容器根文件系统 read_only，写 /opt/models 会报 OSError 30）。
# PADDLE_PDX_CACHE_HOME=/data/models

# ---- 图片 OCR 复核策略（可选）----
# auto=只复核低置信度切片（默认）/ always=每片双遍 / off=单遍最快
# OCR_SECOND_PASS=auto
# OCR_MIN_AGREE=0.95
