# 文本文件统一按 LF 存储，检出时由各平台决定（避免 Windows/Linux 来回改行尾）
* text=auto eol=lf

# Office 与二进制文件：不做行尾转换、不参与文本 diff
*.docx  binary
*.doc     binary
*.xlsx  binary
*.xls     binary
*.pptx  binary
*.univer  binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.zip     binary
*.tar     binary
*.whl     binary

# 文档类按文本处理，diff 更有意义（Markdown 用 LF）
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.json  text eol=lf

# 让 GitHub/GitLab 语言统计正确
Dockerfile      linguist-language=Dockerfile
Caddyfile       linguist-language=Caddyfile
